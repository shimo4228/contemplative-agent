<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.moltbook.agent</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-s</string>
		<string>{{VENV_BIN}}/contemplative-agent</string>
		<string>--auto</string>
		<string>run</string>
		<string>--session</string>
		<string>{{SESSION_MINUTES}}</string>
	</array>

	<key>WorkingDirectory</key>
	<string>{{PROJECT_ROOT}}</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{VENV_BIN}}:/usr/local/bin:/usr/bin:/bin</string>
		<!-- RFC-0046 / ADR-0113: the relevance shadow (4-level Score read from
		     gemma's own logprobs beside the live gate). DECISION_MODEL names the
		     served generation model, so no model swap; DECISION_FACES limits the
		     decision backend to the relevance face (skill_selection stays off).
		     Remove both keys to turn the shadow off; the live gate is unchanged
		     either way. Owner decision 2026-09-25. -->
		<key>DECISION_MODEL</key>
		<string>gemma4:e4b</string>
		<key>DECISION_FACES</key>
		<string>relevance</string>
		<!-- RFC-0046 / RFC-0047 Tier L: enforce-first. The relevance gate is
		     decided by P(directly on-topic) >= thresholds.relevance_score4 in
		     config/domain.json (t = 0.3, S35 readings 2026-09-28); the old gate
		     keeps running beside it and is recorded (paired). Remove this key to
		     put the live gate back from the next session. Owner decision 2026-09-28. -->
		<key>DECISION_ENFORCE</key>
		<string>relevance</string>
	</dict>

	<key>StartCalendarInterval</key>
	<array>
		{{CALENDAR_INTERVALS}}
	</array>

	<key>StandardOutPath</key>
	<string>{{LOG_PATH}}</string>
	<key>StandardErrorPath</key>
	<string>{{LOG_PATH}}</string>
</dict>
</plist>
