<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.moltbook.agent</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-s</string>
		<string>{{VENV_BIN}}/contemplative-agent</string>
		<string>--auto</string>
		<string>run</string>
		<string>--session</string>
		<string>{{SESSION_MINUTES}}</string>
	</array>

	<key>WorkingDirectory</key>
	<string>{{PROJECT_ROOT}}</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{VENV_BIN}}:/usr/local/bin:/usr/bin:/bin</string>
		<!-- RFC-0046 / ADR-0113: the relevance gate reads a 4-level Score from
		     gemma's own logprobs. DECISION_MODEL names the served generation
		     model, so no model swap; DECISION_FACES limits the decision backend
		     to the relevance face (skill_selection stays off). Since 2026-10-09
		     (ADR-0113 amendment 2) these values are also the CLI default when the
		     variables are unset, so removing the keys changes nothing. An empty
		     value turns the gate off, and that stops all feed engagement and seed
		     selection (docs/CONFIGURATION.md). Owner decision 2026-09-25. -->
		<key>DECISION_MODEL</key>
		<string>gemma4:e4b</string>
		<key>DECISION_FACES</key>
		<string>relevance</string>
		<!-- RFC-0046 / RFC-0047 Tier L: enforce-first. The relevance gate is
		     decided by P(directly on-topic) >= thresholds.relevance_score4 in
		     config/domain.json (t = 0.3, S35 readings 2026-09-28). Like the two
		     keys above, this restates the CLI default (ADR-0113 amendment 2):
		     removing it changes nothing, and an empty value turns the gate off,
		     which stops all feed engagement and seed selection. The old
		     free-generated gate no longer runs beside it. Owner decision 2026-09-28. -->
		<key>DECISION_ENFORCE</key>
		<string>relevance</string>
	</dict>

	<key>StartCalendarInterval</key>
	<array>
		{{CALENDAR_INTERVALS}}
	</array>

	<key>StandardOutPath</key>
	<string>{{LOG_PATH}}</string>
	<key>StandardErrorPath</key>
	<string>{{LOG_PATH}}</string>
</dict>
</plist>
