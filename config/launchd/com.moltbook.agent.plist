<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.moltbook.agent</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-s</string>
		<string>{{VENV_BIN}}/contemplative-agent</string>
		<string>--auto</string>
		<string>run</string>
		<string>--session</string>
		<string>{{SESSION_MINUTES}}</string>
	</array>

	<key>WorkingDirectory</key>
	<string>{{PROJECT_ROOT}}</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{VENV_BIN}}:/usr/local/bin:/usr/bin:/bin</string>
		<!-- No DECISION_* keys (ADR-0113 amendment 3): the relevance gate is
		     always on and asks the served Ollama generation model, the CLI's
		     default for an unset DECISION_MODEL. DECISION_MODEL set empty turns the
		     gate off, which makes the feed and seed selection engage with nothing.
		     DECISION_FACES / DECISION_ENFORCE are retired and warned about if set. -->
	</dict>

	<key>StartCalendarInterval</key>
	<array>
		{{CALENDAR_INTERVALS}}
	</array>

	<key>StandardOutPath</key>
	<string>{{LOG_PATH}}</string>
	<key>StandardErrorPath</key>
	<string>{{LOG_PATH}}</string>
</dict>
</plist>
