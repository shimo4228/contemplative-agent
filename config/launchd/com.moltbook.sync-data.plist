<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.moltbook.sync-data</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-s</string>
		<string>{{VENV_BIN}}/contemplative-agent</string>
		<string>sync-data</string>
	</array>

	<key>WorkingDirectory</key>
	<string>{{PROJECT_ROOT}}</string>

	<!-- The script shells out to git, rsync, python3 and (best effort) hf, which
	     the native installers put in ~/.local/bin. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{VENV_BIN}}:{{USER_LOCAL_BIN}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>

	<!-- 05:30: after the 03:30 distill, between the 00:00 and 06:00 agent sessions.
	     The watchdog's sync-data row anchors to this time. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>5</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>{{LOG_PATH}}</string>
	<key>StandardErrorPath</key>
	<string>{{LOG_PATH}}</string>
</dict>
</plist>
