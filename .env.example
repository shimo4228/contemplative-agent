# Environment variables Contemplative Agent reads. Every one is optional.
# Generated from src/contemplative_agent/core/env.py by scripts/render_env_docs.py
# (docs/CONFIGURATION.md#environment-variables has the full table).
#
# The CLI does not load this file by itself. Copy it to .env, edit it, and
# load it into your shell before running a command:
#   set -a; . ./.env; set +a
# Scheduled runs (install-schedule) start from launchd and see none of these:
# no shell exports and no custom MOLTBOOK_HOME. They always use
# ~/.config/moltbook and the defaults shown below.

# --- Moltbook key ---
# `contemplative-agent register --name NAME` saves the new agent's key to
# $MOLTBOOK_HOME/credentials.json, which every command (scheduled runs too)
# reads on its own. Set this only to use a key you already have in commands you
# run yourself; it takes priority over the file. For scheduled runs, write an
# existing key to ~/.config/moltbook/credentials.json as {"api_key": "..."}.
# MOLTBOOK_API_KEY=

# --- Ollama (defaults shown) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# extend trust beyond localhost (e.g. a remote Ollama on the LAN)
# OLLAMA_TRUSTED_HOSTS=

# --- Storage (default: ~/.config/moltbook) ---
# MOLTBOOK_HOME=/custom/path
# CONTEMPLATIVE_CONFIG_DIR=

# --- Decision backend (the relevance gate, ADR-0113) ---
# empty disables the relevance gate's backend (the gate then fails closed)
# DECISION_MODEL=
# DECISION_BUDGET_S=120

# --- Tuning and switches ---
# CONTEMPLATIVE_DIALOGUE_PEER_MODULE=contemplative_agent.cli
# MOLTBOOK_DISTILL_POSTGATE=0
# MOLTBOOK_INSIGHT_FAILOPEN_CAP=20
# MOLTBOOK_SUBMOLT_SCOPE_DISABLE=1
# MOLTBOOK_OPERATOR=
# MOLTBOOK_GATE_SESSION=
# CLAUDE_CODE_SESSION_ID=

# --- Scheduled jobs and scripts (read by scripts/ and the schedule installer) ---
# MOLTBOOK_PIPELINE_STAGES=report
# MOLTBOOK_BACKUP_REPO=
# RSYNC_BIN=
# MOLTBOOK_HF_DATASET=Shimo4228/contemplative-agent-data
# PIPELINE_TASKS_DIR=
# PIPELINE_CLAIMS_PY=
# PIPELINE_WEEKLY_TIMEOUT=5400
# PIPELINE_DEADCODE_TIMEOUT=300
# PIPELINE_DOCSCAN_TIMEOUT=180
# PIPELINE_IDENTITY_TIMEOUT=900
# PIPELINE_LAUNCH_AGENTS_DIR=
# PIPELINE_WATCHDOG_STATUS=
# PIPELINE_KEEP_RUNS=12
# TIMEOUT_BIN=
# WATCHDOG_MIN_FREE_KB=
# PIPELINE_DEADLINE_SECONDS=10800
# PIPELINE_INSIGHT_MARKER_MAX_AGE=21600
# PIPELINE_NEVER_SELECTED_TIMEOUT=300
# PIPELINE_CONFUSION_TIMEOUT=300
# PIPELINE_COMMENT_OUTCOMES_TIMEOUT=300
# WEEKLY_PREV_COUNT=3
# N_SIMS=10
# BENCH_DIR=
# BENCH_REF=
# SKIP_WINDOW_GUARD=1
# ARM_A_FILE=
# ARM_B_FILE=
# DATA_REPO=
# AUDIT_CHECK_BYPASS=1
# VERIFY_OFFLINE=
# VERIFY_REPO_ROOT=
