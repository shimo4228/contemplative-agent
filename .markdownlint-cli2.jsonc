// markdownlint-cli2 — .claude/verify.sh の markdown category。
// 選定理由と ratchet の昇格条件は .claude/verify.md（この階層に再掲しない）。
//
// 方針: 「読み手に届く構造」だけを見る。行の折り返し位置や表の桁揃えは
// レンダラが吸収するので、人間の判断を要求する割に読者への影響がない。
{
  "globs": ["**/*.md"],
  "ignores": [
    // LLM が読む固定 apparatus であって document ではない（ADR-0054）。
    // Markdown として lint すると、プロンプト中のプレースホルダ（<answer>,
    // <number> 等）が MD033 の inline HTML として、見出しで始まらない指示文が
    // MD041 として上がる — どちらも直すべき対象ではない。
    "config/prompts/**",
    "config/templates/**",

    // 起きたことの記録であって、整形しなおす対象ではない。実測（2026-07-31）で
    // --fix が adr-0068 のモデル出力サンプルから行末空白を落としており、逐語
    // 記録に対しては軽微な整形も改変にあたる。
    "docs/evidence/**",

    ".notes/**",

    // eval 層の prompt 資産スナップショット (identity/constitution/skills/rules)。
    // 実運用 MOLTBOOK_HOME からの逐語コピーで、docs/evidence と同じく
    // 「記録であって整形対象ではない」。judge prompt も config/prompts と同種の
    // LLM 向け apparatus (ADR-0089)。
    "evals/fixtures/**",

    // repo の資産ではない。git 管理外なので --staged では見えないが、引数なしの
    // 全体実行は glob で拾ってしまう（実測: MD041 15 件中 11 件が .venv 由来）。
    ".venv/**",
    "node_modules/**",

    // hookify のローカルルール定義。YAML frontmatter を持つ control plane の
    // 設定であって document ではない（git 管理外）。
    "**/*.local.md",

    // ADR-0013 で棚上げされ .gitignore に入っている。repo が所有しない資産を
    // ゲートで縛ると、clone 先に存在しないファイルで FAIL しうる。
    "integrations/skills/**"
  ],
  "config": {
    // 行長は見ない。実測 6151 件、200 字閾値でもなお 1821 件で、内訳は表・URL・
    // 日本語 prose。Markdown はレンダラが折り返すので長い行に読者被害がなく、
    // 折り返し位置は執筆時の判断に属する。コードの行長は ruff（100）が持つ。
    "MD013": false,

    // 表のパイプ桁揃え。1157 件あるが純粋な見た目で、レンダリング結果は同一。
    "MD060": false,

    // 「1 行目は h1 であること」。README / DEVELOPMENT-RECORDS は h1 の上に
    // `Language: English | [日本語](...)` の言語切替行を置く二言語規約で、
    // 非英語話者が最初に必要とする導線なので h1 の下には下げない。実測した
    // 違反 5 件はすべてこの規約か frontmatter を持つ設定ファイルで、title を
    // 欠いた document は 1 本も無かった（rule が測りたいものと合っていない）。
    "MD041": false,

    // 同名見出しの重複。ADR は Status / Context / Decision を節ごとに繰り返す
    // 構造なので、siblings_only にして「同じ親の下での重複」だけを見る。
    "MD024": { "siblings_only": true },

    // <details> / <summary> は README の折りたたみに意図的に使っている。
    "MD033": { "allowed_elements": ["details", "summary", "img", "b", "p"] },

    // --- 以下 3 つは auto-fix が意味を壊すことを実測して外した（2026-07-31）---

    // コードスパン内側の空白。`- ` のように **空白そのものが記述対象** の
    // ケースがあり（ADR-0062 の「`- ` パーサー破損」）、--fix はこれを `-` に
    // 潰して文の主語を消した。空白が有意か否かは意味の判断で、機械には見えない。
    "MD038": false,

    // 番号付きリストの採番。--fix は `4. 5. 6.` を `1. 2. 3.` に振り直すが、
    // 先行する列挙の続きとして意図的に 4 から始めている箇所があり、番号が
    // 本文から参照されうる。どこが「続き」かは機械には判定できない。
    "MD029": false,

    // 箇条書きのマーカー。既定の "consistent" は **ファイル内で最初に現れた
    // マーカー** に合わせるため、たまたま `+` で始まるファイルでは `-` を `+` に
    // 変換し、repo 全体としてはむしろ不揃いになった。repo の実勢である `-` に固定する。
    "MD004": { "style": "dash" }
  }
}
